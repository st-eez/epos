class Epos < Formula
  desc "Push-to-talk dictation app using Apple SpeechTranscriber"
  homepage "https://github.com/YOUR_GITHUB_OWNER/epos"
  url "https://github.com/YOUR_GITHUB_OWNER/epos/archive/refs/tags/v2.0.0.tar.gz"
  sha256 "REPLACE_WITH_SOURCE_TARBALL_SHA256"

  depends_on xcode: ["17.0", :build]
  depends_on "xcodegen" => :build

  def install
    system "scripts/build-local-app.sh"
    libexec.install ".build/xcode/Release/Epos.app"

    (bin/"epos-install-app").write <<~SH
      #!/bin/sh
      set -eu

      app="#{libexec}/Epos.app"
      dest="${INSTALL_APP_PATH:-/Applications/Epos.app}"

      if pgrep -f "$dest/Contents/MacOS/Epos" >/dev/null 2>&1; then
        echo "error: $dest is running. Quit Epos, then rerun this command." >&2
        exit 66
      fi

      mkdir -p "$(dirname "$dest")"
      ditto "$app" "$dest"
      codesign --verify --deep --strict "$dest"
      printf '%s\\n' "$dest"
    SH
  end

  def caveats
    <<~EOS
      Epos was built locally from source and was not notarized.

      Install the app bundle into /Applications with:
        epos-install-app

      Then launch:
        open /Applications/Epos.app

      On first launch, grant Microphone, Speech Recognition, and Accessibility
      permissions. Also disable macOS system dictation for the fn key:
      System Settings -> Keyboard -> Dictation -> Shortcut -> Off.

      For a more stable free local signature, add an Apple ID in Xcode and
      create an Apple Development certificate before installing.
    EOS
  end

  test do
    app = libexec/"Epos.app"
    assert_path_exists app/"Contents/MacOS/Epos"
    system "codesign", "--verify", "--deep", "--strict", app
  end
end
