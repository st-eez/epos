#!/usr/bin/env bash
set -euo pipefail

probe_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
verify_dir="$(mktemp -d "${TMPDIR:-/tmp}/epos-preview-verify.XXXXXX")"
trap 'rm -rf "$verify_dir"' EXIT
sdk_path="$(/usr/bin/xcrun --sdk macosx --show-sdk-path)"

/usr/bin/xcrun swiftc \
  -sdk "$sdk_path" -target arm64-apple-macos26.0 \
  -module-cache-path "$verify_dir/ModuleCache" -warnings-as-errors \
  -o "$verify_dir/tisctl" "$probe_dir/Tools/tisctl.swift"

/usr/bin/xcrun swiftc \
  -sdk "$sdk_path" -target arm64-apple-macos26.0 \
  -module-cache-path "$verify_dir/ModuleCache" -warnings-as-errors \
  -o "$verify_dir/EposProbe" \
  "$probe_dir/Sources/main.swift" \
  "$probe_dir/Sources/ProbeSupport.swift" \
  "$probe_dir/Sources/ProbePreviewSafety.swift" \
  "$probe_dir/Sources/ProbeSessionOwnership.swift" \
  "$probe_dir/Sources/ProbeInputBarrier.swift" \
  "$probe_dir/../../Sources/Epos/Hotkey/DictationShortcut.swift" \
  "$probe_dir/Sources/ProbeInputController.swift" \
  "$probe_dir/Sources/ProbeCommandSocket.swift"

/usr/bin/xcrun swiftc \
  -sdk "$sdk_path" -target arm64-apple-macos26.0 \
  -module-cache-path "$verify_dir/ModuleCache" -warnings-as-errors \
  -o "$verify_dir/PreviewSafetyTests" \
  "$probe_dir/Sources/ProbePreviewSafety.swift" \
  "$probe_dir/Tests/PreviewSafetyTests.swift"
"$verify_dir/PreviewSafetyTests"

/usr/bin/xcrun swiftc \
  -sdk "$sdk_path" -target arm64-apple-macos26.0 \
  -module-cache-path "$verify_dir/ModuleCache" -warnings-as-errors \
  -D EPOS_SESSION_PROTOTYPE -o "$verify_dir/SessionPrototype" \
  "$probe_dir"/Sources/*.swift \
  "$probe_dir/../../Sources/Epos/Hotkey/DictationShortcut.swift"

/usr/bin/xcrun swiftc \
  -sdk "$sdk_path" -target arm64-apple-macos26.0 \
  -module-cache-path "$verify_dir/ModuleCache" -warnings-as-errors \
  -o "$verify_dir/SessionOwnershipTests" \
  "$probe_dir/Sources/ProbePreviewSafety.swift" \
  "$probe_dir/Sources/ProbeInputBarrier.swift" \
  "$probe_dir/../../Sources/Epos/Hotkey/DictationShortcut.swift" \
  "$probe_dir/Sources/ProbeSessionOwnership.swift" \
  "$probe_dir/Tests/SessionOwnershipTests.swift"
"$verify_dir/SessionOwnershipTests"

/usr/bin/xcrun swiftc \
  -sdk "$sdk_path" -target arm64-apple-macos26.0 \
  -module-cache-path "$verify_dir/ModuleCache" -warnings-as-errors \
  -D EPOS_SESSION_PROTOTYPE -o "$verify_dir/SessionWindowTests" \
  "$probe_dir/Sources/ProbeSessionWindow.swift" \
  "$probe_dir/Tests/SessionWindowTests.swift"
"$verify_dir/SessionWindowTests"

/usr/bin/python3 -I "$probe_dir/Tests/SessionRunnerTests.py"
/usr/bin/python3 -I "$probe_dir/Tests/SessionClientTests.py"
/usr/bin/python3 -I "$probe_dir/Tests/InstallerTests.py"
