#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

if [[ -z "${DEVELOPER_DIR:-}" ]]; then
  selected_developer_dir="$(xcode-select -p)"
  if [[ -d "$selected_developer_dir/Platforms/MacOSX.platform" ]]; then
    export DEVELOPER_DIR="$selected_developer_dir"
  else
    xcode_app="$(mdfind 'kMDItemCFBundleIdentifier == "com.apple.dt.Xcode"' | head -n 1)"
    if [[ -z "$xcode_app" ]]; then
      xcode_app="$(
        find /Applications "$HOME/Applications" -maxdepth 1 -type d -name 'Xcode*.app' -print 2>/dev/null |
          sort |
          head -n 1
      )"
    fi
    if [[ -z "$xcode_app" || ! -d "$xcode_app/Contents/Developer/Platforms/MacOSX.platform" ]]; then
      echo "error: a full Xcode installation is required" >&2
      exit 69
    fi
    export DEVELOPER_DIR="$xcode_app/Contents/Developer"
  fi
fi

if (( $# > 1 )); then
  echo "usage: scripts/bench [recording-count]" >&2
  exit 64
fi
if (( $# == 1 )) && [[ ! "$1" =~ ^[0-9]+$ ]]; then
  echo "usage: scripts/bench [recording-count]" >&2
  exit 64
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
output="${EPOS_EVAL_OUTPUT:-$repo_root/.build/evals/apple-presets-signed-$timestamp.jsonl}"

echo "info: replacing /Applications/Epos.app with a signed Debug build" >&2
"$script_dir/install-signed-app.sh" >/dev/null

if [[ "$#" -eq 1 ]]; then
  EPOS_EVAL_LIMIT="$1" \
  EPOS_RUN_SIGNED_APPLE_PRESET_EVAL=1 \
  EPOS_EVAL_OUTPUT="$output" \
    /Applications/Epos.app/Contents/MacOS/Epos
else
  EPOS_RUN_SIGNED_APPLE_PRESET_EVAL=1 \
  EPOS_EVAL_OUTPUT="$output" \
    /Applications/Epos.app/Contents/MacOS/Epos
fi
